# ==================== DATABASE (Supabase) ====================
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Sync version (for Alembic migrations)
DATABASE_URL_SYNC=postgresql://postgres.xxxxx:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ==================== SECURITY ====================
SECRET_KEY=generate-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ENCRYPTION_KEY: Generate with: python -c "from app.core.security import generate_encryption_key; print(generate_encryption_key())"
ENCRYPTION_KEY=your-32-byte-base64-key

# ==================== CORS ====================
# Allow your EasyPanel domain + localhost for dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== RATE LIMITING ====================
RATE_LIMIT_PER_MINUTE=120

# ==================== OPTIONAL ====================
# Redis (leave empty if not using)
REDIS_URL=

# Sentry (leave empty if not using)
SENTRY_DSN=

# SMTP for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
