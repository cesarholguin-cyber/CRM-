# Copiar a .env.oracle (ignorado por Git). No activar hasta terminar la migración.
DATABASE_MODE=oracle
ORACLE_USER=RF_CRM
ORACLE_PASSWORD=
# Alias de tnsnames.ora, por ejemplo crm_low, o descriptor TLS de Oracle.
ORACLE_DSN=
ORACLE_CONFIG_DIR=/run/secrets/oracle-wallet
ORACLE_WALLET_LOCATION=/run/secrets/oracle-wallet
ORACLE_WALLET_PASSWORD=
# Conservar el valor actual de backend/data/.session-key o SECRET_KEY de Easypanel.
SECRET_KEY=
# Conservar exactamente el valor actual; cambiarlo impide leer datos cifrados anteriores.
ENCRYPTION_KEY=

# Activar oci solo después de crear y verificar el bucket.
DOCUMENT_STORAGE=database
OCI_CONFIG_FILE=/run/secrets/oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_BUCKET=rf-crm-documentos
OCI_COMPARTMENT_ID=
CORS_ORIGINS=https://aztrotech-crm-terrenos.9wq2vl.easypanel.host,https://rf-campestre-aztrotech.cesarholguin.chatgpt.site
