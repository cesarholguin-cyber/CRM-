# Preparación solamente. No activar hasta importar el respaldo de Easypanel.
DATABASE_MODE=supabase
DATABASE_URL=postgresql+psycopg://postgres.nxpqpowuslnsujrlmppx:REEMPLAZAR@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Mantener el SECRET_KEY actual o el contenido de backend/data/.session-key del VPS.
SECRET_KEY=
# Mantener exactamente el ENCRYPTION_KEY actual (también si está vacío).
ENCRYPTION_KEY=
# Conserva documentos en la base durante la primera migración.
DOCUMENT_STORAGE=database
# El backend usa el esquema privado crm; las claves API no sustituyen DATABASE_URL.
# Copiar a .env.supabase.local, excluido de Git, con permisos 600.
